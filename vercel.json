{
  "redirects": [
    {
      "source": "/sitemap.xml/",
      "destination": "/sitemap.xml",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/product/:category/:id",
      "destination": "/"
    },
    {
      "source": "/catalog/:category",
      "destination": "/"
    }
  ]
}
